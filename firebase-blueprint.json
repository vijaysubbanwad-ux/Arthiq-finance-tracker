{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and financial preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "currency": { "type": "string" },
        "monthlyIncome": { "type": "number" },
        "monthlyBudget": { "type": "number" },
        "savingsTarget": { "type": "number" },
        "theme": { "type": "string" },
        "darkMode": { "type": "boolean" },
        "language": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "An income or expense transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "amount", "type", "category", "date", "paymentMethod"]
    },
    "budget": {
      "title": "Budget",
      "description": "Budget category limit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "period": { "type": "string" }
      },
      "required": ["id", "userId", "category", "amount", "period"]
    },
    "goal": {
      "title": "Goal",
      "description": "Savings target goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string" },
        "icon": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "targetAmount", "currentAmount", "createdAt"]
    },
    "subscription": {
      "title": "Subscription",
      "description": "Recurring subscription or bill",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "billingCycle": { "type": "string" },
        "renewalDate": { "type": "string" },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["id", "userId", "name", "amount", "billingCycle", "renewalDate", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Stores user settings and profile information"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Personal transactions recorded by the user"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "budget",
      "description": "Budget limits set by the user"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "goal",
      "description": "Savings goals set by the user"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": "subscription",
      "description": "Subscriptions tracked by the user"
    }
  }
}
